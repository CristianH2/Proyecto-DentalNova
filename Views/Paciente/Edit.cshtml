@model Proyecto_DentalNova.Models.PacienteViewModel.PacienteVM;


@{
    ViewData["Title"] = "Editar Paciente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="row">
    <div class="col-12">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Paciente.Id" />
            <input type="hidden" asp-for="Paciente.UsuarioId" />
            <input type="hidden" asp-for="Paciente.FechaCreacion" />

            <partial name="_PacienteFormulario" model="Model" />

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        // Espera a que el documento esté completamente cargado para ejecutar el código.
        $(function () {
            // Guarda las referencias a los elementos del DOM para un acceso más rápido.
            const usuarioSelect = $('#usuarioSelect');
            const edadInput = $('#edadInput');

            // Función para calcular la edad (la lógica es la misma que en JavaScript puro).
            function calculateAge(birthDateString) {
                if (!birthDateString) {
                    return ''; // Devuelve vacío si no hay fecha.
                }
                const birthDate = new Date(birthDateString);
                const today = new Date();
                let age = today.getFullYear() - birthDate.getFullYear();
                const m = today.getMonth() - birthDate.getMonth();

                // Ajusta la edad si aún no ha pasado el cumpleaños de este año.
                if (m < 0 || (m === 0 && today.getDate() < birthDate.getDate())) {
                    age--;
                }
                return age;
            }

            // Asocia el evento 'change' al dropdown de usuarios.
            usuarioSelect.on('change', function () {
                // Encuentra la opción que está actualmente seleccionada.
                const selectedOption = $(this).find('option:selected');

                // Obtiene el valor del atributo 'data-fecha-nacimiento' usando el método .data() de jQuery.
                const fechaNacimiento = selectedOption.data('fecha-nacimiento');

                // Calcula la edad.
                const edad = calculateAge(fechaNacimiento);

                // Asigna el resultado al campo de edad usando el método .val() de jQuery.
                edadInput.val(edad);
            });
        });
    </script>
}