@model IEnumerable<Proyecto_DentalNova.Models.Paciente>

@{
    ViewData["Title"] = "Gestión de Pacientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-6">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Registrar Nuevo Paciente
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre del Paciente</th>
                            <th>Correo Electrónico</th>
                            <th>Teléfono</th>
                            <th>Edad</th>
                            <th>Fecha de Registro</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Usuario?.Nombre @item.Usuario?.Apellidos</td>
                                <td>@item.Usuario?.CorreoElectronico</td>
                                <td>@(item.Usuario?.Telefono ?? "N/A")</td>
                                <td>@item.Edad años</td>
                                <td>@item.FechaCreacion.ToShortDateString()</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.Id" title="Ver Expediente">
                                            <i class="bi bi-file-earmark-medical"></i>
                                        </a>
                                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id" title="Editar Expediente">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar Paciente">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>