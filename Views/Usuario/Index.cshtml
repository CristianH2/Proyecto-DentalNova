@model IEnumerable<Proyecto_DentalNova.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-6">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Crear Nuevo Usuario
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nombre Completo</th>
                            <th>Correo Electrónico</th>
                            <th>Teléfono</th>
                            <th>Género</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Nombre @item.Apellidos</td>
                                <td>@item.CorreoElectronico</td>
                                <td>@(item.Telefono ?? "N/A")</td>
                                <td>
                                    @switch (item.Genero)
                                    {
                                        case 'M':
                                            <span>Masculino</span>
                                            ; break;
                                        case 'F':

                                            <span>Femenino</span>
                                            ; break;
                                        case 'O':

                                            <span>Otro</span>
                                            ; break;
                                        default:

                                            <span>No especificado</span>
                                            ; break;
                                    }
                                </td>
                                <td>
                                    @if (item.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">

                                        <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.Id" title="Detalles">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>