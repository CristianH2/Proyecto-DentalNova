@model Proyecto_DentalNova.Models.OdontologoViewModel.OdontologoVM;

@{
    ViewData["Title"] = "Registrar Nuevo Odontólogo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="row">
    <div class="col-12">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <partial name="_OdontologoFormulario" />

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Registrar Odontólogo</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
