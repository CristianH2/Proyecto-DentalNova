@model Proyecto_DentalNova.Models.OdontologoViewModel.OdontologoVM;

@{
    ViewData["Title"] = "Editar Información del Odontólogo";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>
<hr />
<div class="row">
    <div class="col-12">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Odontologo.Id" />
            <input type="hidden" asp-for="Odontologo.UsuarioId" />

            <partial name="_OdontologoFormulario" model="Model" />

            <div class="form-group mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Guardar Cambios</button>
                <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Cancelar</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}