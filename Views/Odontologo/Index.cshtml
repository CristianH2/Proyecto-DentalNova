@model IEnumerable<Proyecto_DentalNova.Models.Odontologo>

@{
    ViewData["Title"] = "Gestión de Odontólogos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-6">
            <h1>@ViewData["Title"]</h1>
        </div>
        <div class="col-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Registrar Nuevo Odontólogo
            </a>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover table-striped">
                    <thead class="table-light">
                        <tr>
                            <th>Nombre del Odontólogo</th>
                            <th>Correo Electrónico</th>
                            <th>Especialidades</th>
                            <th>Cédula Profesional</th>
                            <th>Fecha de Ingreso</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Usuario?.Nombre @item.Usuario?.Apellidos</td>
                                <td>@item.Usuario?.CorreoElectronico</td>
                                <td>
                                    @if (item.Especialidades != null && item.Especialidades.Any())
                                    {
                                        // Muestra cada especialidad como una "píldora" de color
                                        foreach (var especialidad in item.Especialidades)
                                        {
                                            <span class="badge rounded-pill bg-info text-dark me-1">@especialidad.Nombre</span>
                                        }
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin especialidad</span>
                                    }
                                </td>
                                <td>@item.CedulaProfesional</td>
                                <td>@item.FechaIngreso.ToShortDateString()</td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.Id" title="Ver Perfil">
                                            <i class="bi bi-person-lines-fill"></i>
                                        </a>
                                        <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id" title="Editar Perfil">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar Odontólogo">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>