<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DentalNova.Movil.ViewModels"
             xmlns:model="clr-namespace:DentalNova.Movil.Models"
             xmlns:helpers="clr-namespace:DentalNova.Movil.Helpers"
             x:Class="DentalNova.Movil.Pages.NotificacionesPage"
             Title="{Binding Title}"
             BackgroundColor="#F5F5F5">
    <Grid>
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="10"
                             IsVisible="{Binding Notificaciones.Count, Converter={StaticResource InverseBoolConverter}}">
            <Label Text="🔔" FontSize="50" HorizontalOptions="Center"/>
            <Label Text="Sin notificaciones nuevas" TextColor="Gray"/>
        </VerticalStackLayout>

        <CollectionView ItemsSource="{Binding Notificaciones}" Margin="15">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="model:NotificacionDto">
                    <Grid Padding="0,5">
                        <Border Padding="15" BackgroundColor="White" StrokeThickness="0">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10"/>
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                            </Border.Shadow>

                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="Auto, *">
                                    <Label Grid.Column="0" Text="📩" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <Label Grid.Column="1" Text="{Binding DoctorNombre, StringFormat='Dr. {0}'}" FontAttributes="Bold" TextColor="#333"/>
                                </Grid>

                                <Label Text="{Binding Mensaje}" TextColor="#555" FontSize="14"/>

                                <Label Text="{Binding FechaFormateada}" 
                                       TextColor="Silver" FontSize="11" HorizontalOptions="End"/>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" 
                           VerticalOptions="Center" HorizontalOptions="Center" Color="Blue"/>
    </Grid>
</ContentPage>