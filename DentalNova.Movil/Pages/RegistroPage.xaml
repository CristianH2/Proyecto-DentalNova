<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DentalNova.Movil.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             x:Class="DentalNova.Movil.Pages.RegistroPage"
             Title="Registro de Paciente"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Crear Nueva Cuenta" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#333"/>
            <Label Text="Complete sus datos para comenzar" FontSize="14" HorizontalOptions="Center" TextColor="Gray"/>

            <Border BackgroundColor="White" Padding="15" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="👤 Datos Personales" FontAttributes="Bold" TextColor="#007BFF"/>

                    <Entry Placeholder="Nombre(s)" Text="{Binding Nombre}" />
                    <Entry Placeholder="Apellidos" Text="{Binding Apellidos}" />
                    <Entry Placeholder="Teléfono" Text="{Binding Telefono}" Keyboard="Telephone"/>
                    <Entry Placeholder="CURP" Text="{Binding Curp}" />

                    <Label Text="Fecha de Nacimiento" FontSize="12" TextColor="Gray"/>
                    <DatePicker Date="{Binding FechaNacimiento}" MaximumDate="{x:Static sys:DateTime.Today}" />

                    <Picker Title="Género" SelectedItem="{Binding Genero}">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Masculino</x:String>
                                <x:String>Femenino</x:String>
                                <x:String>Otro</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Padding="15" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="🔒 Seguridad" FontAttributes="Bold" TextColor="#007BFF"/>

                    <Entry Placeholder="Correo Electrónico" Text="{Binding Email}" Keyboard="Email"/>
                    <Entry Placeholder="Contraseña" Text="{Binding Password}" IsPassword="True"/>
                    <Entry Placeholder="Confirmar Contraseña" Text="{Binding ConfirmPassword}" IsPassword="True"/>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="White" Padding="15" StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="🏥 Antecedentes Médicos" FontAttributes="Bold" TextColor="#007BFF"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="¿Tiene Alergias?" VerticalOptions="Center"/>
                        <Switch IsToggled="{Binding ConAlergias}" Grid.Column="1"/>
                    </Grid>
                    <Entry Placeholder="Describa sus alergias..." Text="{Binding Alergias}" 
                           IsVisible="{Binding ConAlergias}"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="¿Enfermedades Crónicas?" VerticalOptions="Center"/>
                        <Switch IsToggled="{Binding ConEnfermedades}" Grid.Column="1"/>
                    </Grid>
                    <Entry Placeholder="Describa enfermedades..." Text="{Binding Enfermedades}" 
                           IsVisible="{Binding ConEnfermedades}"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="¿Toma Medicamentos?" VerticalOptions="Center"/>
                        <Switch IsToggled="{Binding ConMedicamentos}" Grid.Column="1"/>
                    </Grid>
                    <Entry Placeholder="Nombre y dosis..." Text="{Binding Medicamentos}" 
                           IsVisible="{Binding ConMedicamentos}"/>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="¿Antecedentes Familiares?" VerticalOptions="Center"/>
                        <Switch IsToggled="{Binding ConAntecedentes}" Grid.Column="1"/>
                    </Grid>
                    <Entry Placeholder="Diabetes, Hipertensión, etc." Text="{Binding Antecedentes}" 
                           IsVisible="{Binding ConAntecedentes}"/>
                </VerticalStackLayout>
            </Border>

            <Button Text="Registrarme" 
                    Command="{Binding RegistrarCommand}" 
                    CornerRadius="25" 
                    HeightRequest="50"
                    BackgroundColor="#007BFF" 
                    Margin="0,10,0,0"/>

            <Button Text="Cancelar" 
                    Command="{Binding CancelarCommand}" 
                    BackgroundColor="Transparent" 
                    TextColor="Gray"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="Blue"/>

        </VerticalStackLayout>
    </ScrollView>



</ContentPage>