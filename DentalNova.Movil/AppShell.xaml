<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DentalNova.Movil.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DentalNova.Movil"
    xmlns:Pages="clr-namespace:DentalNova.Movil.Pages"
    Title="DentalNova"
    Shell.NavBarIsVisible="True"
    Shell.TabBarBackgroundColor="{StaticResource Primary}"
    Shell.TabBarTitleColor="White"
    Shell.TabBarUnselectedColor="#95C2FF">

    <TabBar>
        <ShellContent
            Title="Mis Citas"
            Icon="icon_citas.png" 
            ContentTemplate="{DataTemplate Pages:CitasPage}"
            Route="CitasPage" />

        <ShellContent
            Title="Agendar"
            Icon="icon_agendar.png"
            ContentTemplate="{DataTemplate Pages:AgendarPage}"
            Route="AgendarPage" />

        <ShellContent
            Title="Notificaciones"
            Icon="icon_notif.png"
            ContentTemplate="{DataTemplate Pages:NotificacionesPage}"
            Route="NotificacionesPage" />

        <ShellContent
            Title="Perfil"
            Icon="icon_perfil.png"
            ContentTemplate="{DataTemplate Pages:PerfilPage}"
            Route="PerfilPage" />
    </TabBar>

</Shell>
