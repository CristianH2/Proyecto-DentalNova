@model Proyecto_DentalNova.Models.CitaViewModel.CitaVM

@{
    ViewData["Title"] = "Nueva Cita";
    Layout = "~/Views/Shared/_LayoutOdontologo.cshtml";
}

<script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.8/index.global.min.js'></script>

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-0">Agendar Cita</h2>
            <p class="text-muted mb-0">Programe una nueva visita para sus pacientes.</p>
        </div>
        <a asp-action="MisCitas" class="btn btn-outline-secondary">
            <i class="fas fa-times me-2"></i> Cancelar
        </a>
    </div>

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm">
            <i class="fas fa-exclamation-triangle me-2"></i> @TempData["MensajeError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <div class="col-lg-8">
            <form asp-action="Agendar" method="post" class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <input type="hidden" asp-for="Cita.OdontologoId" id="hiddenOdontologoId" />

                    <h5 class="text-primary mb-3 border-bottom pb-2"><i class="fas fa-user-injured me-2"></i>Datos del Paciente</h5>
                    <div class="mb-4">
                        <label asp-for="Cita.PacienteId" class="form-label small fw-bold text-muted text-uppercase">Seleccione Paciente</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-search"></i></span>
                            <div class="flex-grow-1" style="min-width: 0;">
                                <select asp-for="Cita.PacienteId" asp-items="Model.Pacientes" class="form-select select2-search" required>
                                    <option value=""></option>
                                </select>
                            </div>
                        </div>
                        <span asp-validation-for="Cita.PacienteId" class="text-danger small"></span>
                    </div>

                    <h5 class="text-primary mb-3 border-bottom pb-2"><i class="far fa-clock me-2"></i> Programación</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-7">
                            <label asp-for="Cita.FechaHora" class="form-label small fw-bold text-muted text-uppercase">Inicio de Cita</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="far fa-calendar-alt"></i></span>
                                <input asp-for="Cita.FechaHora" class="form-control" type="datetime-local"
                                       id="inputFechaHora"
                                       min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                       value="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")"
                                       required />

                                <button type="button" class="btn btn-primary" id="btnVerCalendario"
                                        data-bs-toggle="modal" data-bs-target="#modalCalendario"
                                        title="Consultar mi disponibilidad visual">
                                    <i class="fas fa-calendar-week me-2"></i> Ver Agenda
                                </button>
                            </div>
                            <span asp-validation-for="Cita.FechaHora" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="Cita.DuracionMinutos" class="form-label small fw-bold text-muted text-uppercase">Duración Estimada</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="fas fa-hourglass-half"></i></span>
                                <select asp-for="Cita.DuracionMinutos" asp-items="Model.Duraciones" class="form-select" required></select>
                            </div>
                            <span asp-validation-for="Cita.DuracionMinutos" class="text-danger small"></span>
                        </div>
                    </div>

                    <h5 class="text-primary mb-3 border-bottom pb-2"><i class="fas fa-tooth me-2"></i>Detalle Clínico</h5>
                    <div class="mb-4">
                        <label asp-for="TratamientosSeleccionados" class="form-label small fw-bold text-muted text-uppercase">Tratamientos a realizar</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="fas fa-notes-medical"></i></span>
                            <div class="flex-grow-1" style="min-width: 0;">
                                <select asp-for="TratamientosSeleccionados" asp-items="Model.Tratamientos" class="form-select select2-multiple" multiple="multiple" style="width: 100%;">
                                </select>
                            </div>
                        </div>
                        <div class="form-text small">Puede seleccionar varios procedimientos.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Cita.MotivoConsulta" class="form-label small fw-bold text-muted text-uppercase">Notas / Motivo</label>
                        <textarea asp-for="Cita.MotivoConsulta" class="form-control" rows="2" placeholder="Ej: Continuación de tratamiento de conducto..."></textarea>
                    </div>

                </div>
                <div class="card-footer bg-light p-3 d-flex justify-content-end gap-2">
                    <button type="submit" class="btn btn-success px-5 fw-bold shadow-sm">
                        <i class="fas fa-check-circle me-2"></i> Confirmar Cita
                    </button>
                </div>
            </form>
        </div>

        <div class="col-lg-4">
            <div class="sticky-top" style="top: 1.5rem; z-index: 10;">
                <div class="card shadow-sm border-0 border-top border-primary border-4">
                    <div class="card-header bg-white py-3">
                        <h6 class="m-0 fw-bold text-dark"><i class="fas fa-info-circle me-2 text-primary"></i> Mis Horarios Base</h6>
                    </div>
                    <div class="card-body p-0">

                        <div id="panelLoading" class="text-center py-5 d-none">
                            <div class="spinner-border text-primary mb-3" role="status"></div>
                            <p class="text-muted small">Cargando configuración...</p>
                        </div>

                        <div id="panelHorarios" class="d-none">
                            <div class="list-group list-group-flush" id="listaHorariosContainer">
                            </div>
                        </div>

                        <div id="msgSinHorarios" class="text-center py-5 d-none">
                            <i class="far fa-calendar-times fa-3x text-secondary opacity-25 mb-3"></i>
                            <p class="text-muted small px-3">No tiene turnos fijos configurados en el sistema.</p>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalCalendario" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="far fa-calendar-check me-2"></i>Mi Agenda en Tiempo Real</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div id="calendar" style="min-height: 600px;"></div>
            </div>
            <div class="modal-footer bg-light">
                <div class="me-auto small">
                    <span class="badge bg-primary me-1">■</span>Ocupado
                    <span class="text-muted ms-2"><i class="fas fa-mouse-pointer"></i> Haga clic en un espacio vacío para asignar la fecha.</span>
                </div>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // INICIALIZACIÓN DE COMPONENTES
            $('.select2-search').select2({ theme: 'bootstrap-5', width: '100%', placeholder: 'Buscar...', allowClear: true });
            $('.select2-multiple').select2({ theme: 'bootstrap-5', width: '100%', placeholder: 'Seleccione...', closeOnSelect: false });

            // REFERENCIAS
            const myOdontologoId = document.getElementById('hiddenOdontologoId').value;
            const inputFecha = document.getElementById('inputFechaHora');

            // Sidebar References
            const panelLoading = document.getElementById('panelLoading');
            const panelHorarios = document.getElementById('panelHorarios');
            const msgSin = document.getElementById('msgSinHorarios');
            const container = document.getElementById('listaHorariosContainer');

            // Calendar References
            const modalEl = document.getElementById('modalCalendario');
            const calendarEl = document.getElementById('calendar');
            let calendar = null;

            // LOGICA SIDEBAR (Horarios Fijos)
            function cargarHorarios() {
                if (!myOdontologoId) return;

                panelLoading.classList.remove('d-none');
                panelHorarios.classList.add('d-none');
                msgSin.classList.add('d-none');

                const url = '@Url.Action("GetHorariosOdontologo", "Cita")?id=' + myOdontologoId;

                fetch(url)
                    .then(response => response.json())
                    .then(data => {
                        panelLoading.classList.add('d-none');
                        container.innerHTML = '';

                        if (data && data.length > 0) {
                            data.forEach(item => {
                                const html = `
                                    <div class="list-group-item px-3 py-3">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-10 text-uppercase">${item.dia}</span>
                                            <small class="text-muted fw-bold">${item.consultorio}</small>
                                        </div>
                                        <div class="d-flex align-items-center text-dark">
                                            <i class="far fa-clock text-success me-2"></i>
                                            <span class="fw-bold">${item.horario}</span>
                                        </div>
                                    </div>`;
                                container.innerHTML += html;
                            });
                            panelHorarios.classList.remove('d-none');
                        } else {
                            msgSin.classList.remove('d-none');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        panelLoading.classList.add('d-none');
                        msgSin.classList.remove('d-none');
                    });
            }

            // LOGICA FULLCALENDAR
            function initCalendar() {
                calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: 'timeGridWeek',
                    locale: 'es',
                    themeSystem: 'bootstrap5',
                    headerToolbar: {
                        left: 'prev,next today',
                        center: 'title',
                        right: 'dayGridMonth,timeGridWeek,timeGridDay'
                    },
                    slotMinTime: '07:00:00',
                    slotMaxTime: '21:00:00',
                    allDaySlot: false,
                    height: 'auto',
                    expandRows: true,

                    // Clic en espacio vacío -> Asignar fecha
                    dateClick: function(info) {
                        let fechaStr = info.dateStr;
                        // Recortar a yyyy-MM-ddTHH:mm
                        if(fechaStr.length > 16) fechaStr = fechaStr.substring(0, 16);

                        inputFecha.value = fechaStr;
                        bootstrap.Modal.getInstance(modalEl).hide();
                    },

                    // Cargar eventos (Agenda Ocupada)
                    events: function(info, successCallback, failureCallback) {
                        if (!myOdontologoId) { successCallback([]); return; }

                        var url = '@Url.Action("GetEventosOdontologo", "Cita")' +
                                  '?odontologoId=' + myOdontologoId +
                                  '&start=' + info.startStr +
                                  '&end=' + info.endStr;

                        fetch(url)
                            .then(response => response.json())
                            .then(data => successCallback(data))
                            .catch(err => { console.error(err); failureCallback(err); });
                    }
                });
                calendar.render();
            }

            // EJECUCIÓN AL CARGAR

            initCalendar();
            cargarHorarios();

            // Eventos del Modal
            modalEl.addEventListener('shown.bs.modal', function () {
                calendar.render();

                if(inputFecha.value) {
                    calendar.gotoDate(inputFecha.value);
                }

                calendar.refetchEvents();
            });
        });
    </script>
}