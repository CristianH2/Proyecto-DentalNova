@model Proyecto_DentalNova.Models.CitaViewModel.CitaIndexViewModel

@{
    ViewData["Title"] = "Agenda de Citas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="row g-3">
    <div class="col-12 col-xl-3">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center"><i class="bi bi-funnel-fill me-2"></i><strong>Filtro de Búsqueda</strong></div>
            <div class="card-body">
                <form method="get" class="vstack gap-3">
                    <div>
                        <label asp-for="Filtro.Id" class="form-label"></label>
                        <input asp-for="Filtro.Id" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="Filtro.PacienteNombreLike" class="form-label"></label>
                        <input asp-for="Filtro.PacienteNombreLike" class="form-control" placeholder="Nombre o Apellido..." />
                    </div>
                    <div>
                        <label asp-for="Filtro.OdontologoNombreLike" class="form-label"></label>
                        <input asp-for="Filtro.OdontologoNombreLike" class="form-control" placeholder="Nombre o Apellido..." />
                    </div>
                    <div class="row g-2">
                        <div class="col">
                            <label asp-for="Filtro.FechaDesde" class="form-label small"></label>
                            <input asp-for="Filtro.FechaDesde" type="date" class="form-control" />
                        </div>
                        <div class="col">
                            <label asp-for="Filtro.FechaHasta" class="form-label small"></label>
                            <input asp-for="Filtro.FechaHasta" type="date" class="form-control" />
                        </div>
                    </div>
                    <div>
                        <label asp-for="Filtro.Estatus" class="form-label"></label>
                        <select asp-for="Filtro.Estatus" asp-items="@Model.Filtro.EstatusDisponibles" class="form-select">
                            <option value="">(Todos los Estatus)</option>
                        </select>
                    </div>

                    <div class="d-grid gap-2 mt-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Aplicar Filtro</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                </form>
                <hr />
                <a class="btn btn-success w-100" asp-action="Create"><i class="bi bi-plus-circle"></i> Agendar Nueva Cita</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-9">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Resultados (@Model.Resultados?.TotalCount ?? 0)</span>
            </div>
            <div class="card-body p-0">
                <form method="get" class="m-0 p-0">
                    @foreach (var prop in Model.Filtro.GetType().GetProperties().Where(p => !p.Name.Contains("Disponibles")))
                    {
                        var value = prop.GetValue(Model.Filtro);
                        if (value != null)
                        {
                            <input type="hidden" name="Filtro.@prop.Name" value="@value" />
                        }
                    }

                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Fecha y Hora</th>
                                    <th>Paciente</th>
                                    <th>Odontólogo</th>
                                    <th>Estatus</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Resultados != null && Model.Resultados.Any())
                                {
                                    foreach (var item in Model.Resultados)
                                    {
                                        <tr>
                                            <td><strong>@item.Id</strong></td>
                                            <td><strong>@item.FechaHora.ToString("g")</strong></td>
                                            <td>@item.Paciente?.Usuario?.Nombre @item.Paciente?.Usuario?.Apellidos</td>
                                            <td>@item.Odontologo?.Usuario?.Nombre @item.Odontologo?.Usuario?.Apellidos</td>
                                            <td><span class="badge bg-info text-dark">@item.EstatusCita</span></td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a class="btn btn-sm btn-primary" asp-action="Details" asp-route-id="@item.Id" title="Gestionar Cita">
                                                        <i class="bi bi-box-arrow-in-right"></i> Gestionar
                                                    </a>
                                                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar Cita">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="5" class="text-center text-muted p-4">No se encontraron resultados.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Resultados != null && Model.Resultados.Any())
                    {
                        <div class="p-3">
                            @await Html.PartialAsync("_Pagination", Model.Resultados)
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>




