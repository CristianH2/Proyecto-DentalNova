@model Proyecto_DentalNova.Models.CitaViewModel.CitaIndexViewModel
@using DentalNova.Core.Repository.Entities

@{
    ViewData["Title"] = "Agenda de Citas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@Html.AntiForgeryToken()
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0">@ViewData["Title"]</h2>
        <p class="text-muted mb-0">Gestión de agenda y seguimiento de consultas.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-calendar-plus me-2"></i> Agendar Nueva Cita
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between"
         data-bs-toggle="collapse" data-bs-target="#collapseFiltros" style="cursor: pointer;">
        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-filter me-2"></i> Filtros de Búsqueda</h6>
        <i class="fas fa-chevron-down text-muted small"></i>
    </div>

    <div class="collapse show" id="collapseFiltros">
        <div class="card-body bg-light bg-opacity-25">
            <form asp-action="Index" method="get" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">Rango de Fechas</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="far fa-calendar-alt"></i></span>
                        <input asp-for="Filtro.FechaInicio" type="date" class="form-control" placeholder="Desde" />
                        <span class="input-group-text bg-light">-</span>
                        <input asp-for="Filtro.FechaFin" type="date" class="form-control" placeholder="Hasta" />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">Paciente</label>
                    <div class="input-group input-group-sm flex-nowrap">
                        <span class="input-group-text bg-white"><i class="fas fa-user-injured"></i></span>
                        <div class="flex-grow-1" style="min-width: 0;">
                            <select asp-for="Filtro.PacienteId" asp-items="Model.Pacientes" class="form-select select2-filtro">
                                <option value="">(Todos los Pacientes)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">Odontólogo</label>
                    <div class="input-group input-group-sm flex-nowrap">
                        <span class="input-group-text bg-white"><i class="fas fa-user-md"></i></span>
                        <div class="flex-grow-1" style="min-width: 0;">
                            <select asp-for="Filtro.OdontologoId" asp-items="Model.Odontologos" class="form-select select2-filtro">
                                <option value="">(Todos los Doctores)</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted text-uppercase">Estado</label>
                    <select asp-for="Filtro.Estatus" asp-items="Model.Estatus" class="form-select form-select-sm">
                        <option value="">(Todos)</option>
                    </select>
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <div class="d-grid w-100 gap-1">
                        <button type="submit" class="btn btn-sm btn-primary fw-bold" title="Buscar"><i class="fas fa-search me-1"></i> Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-light border text-muted" title="Limpiar"><i class="fas fa-eraser me-1"></i> Limpiar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
        <h6 class="m-0 fw-bold text-primary">Citas Programadas</h6>
        <span class="badge bg-primary rounded-pill">Total: @(Model.Resultados.TotalCount)</span>
    </div>

    <div class="card-body p-0">
        <form method="get" id="paginacionForm" class="m-0 p-0">
            <input type="hidden" asp-for="Filtro.PacienteId" />
            <input type="hidden" asp-for="Filtro.OdontologoId" />
            <input type="hidden" asp-for="Filtro.Estatus" />
            <input type="hidden" asp-for="Filtro.PageSize" />

            <input type="hidden" name="Filtro.FechaInicio" value="@(Model.Filtro.FechaInicio?.ToString("yyyy-MM-dd"))" />
            <input type="hidden" name="Filtro.FechaFin" value="@(Model.Filtro.FechaFin?.ToString("yyyy-MM-dd"))" />

            @if (Model.Resultados == null && !Model.Resultados.Any())
            {
                <div class="text-center py-5">
                    <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                        <i class="far fa-calendar-check fa-3x text-muted opacity-50"></i>
                    </div>
                    <h5 class="text-muted fw-bold">Agenda Libre</h5>
                    <p class="text-muted small mb-0">No se encontraron citas con los criterios actuales.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase small text-muted">
                            <tr>
                                <th class="ps-4">Fecha</th>
                                <th>Horario</th>
                                <th>Paciente</th>
                                <th>Doctor</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Gestión</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Resultados)
                            {
                                // Configuración de Estilos según Estado
                                string badgeClass = item.EstatusCita switch
                                {
                                    Enumerables.EstatusCita.Programada => "bg-primary bg-opacity-10 text-primary border-primary border-opacity-25",
                                    Enumerables.EstatusCita.Completada => "bg-success bg-opacity-10 text-success border-success border-opacity-25",
                                    Enumerables.EstatusCita.Cancelada => "bg-danger bg-opacity-10 text-danger border-danger border-opacity-25",
                                    Enumerables.EstatusCita.NoAsistida => "bg-warning bg-opacity-10 text-dark border-warning border-opacity-25",
                                    _ => "bg-secondary bg-opacity-10 text-secondary"
                                };

                                string iconClass = item.EstatusCita switch
                                {
                                    Enumerables.EstatusCita.Programada => "fa-clock",
                                    Enumerables.EstatusCita.Completada => "fa-check-circle",
                                    Enumerables.EstatusCita.Cancelada => "fa-ban",
                                    Enumerables.EstatusCita.NoAsistida => "fa-user-slash",
                                    _ => "fa-circle"
                                };

                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light border rounded text-center p-2 me-3" style="min-width: 50px;">
                                                <span class="d-block small text-muted fw-bold text-uppercase" style="font-size: 0.65rem;">
                                                    @item.FechaHora.ToString("MMM")
                                                </span>
                                                <span class="d-block fs-5 fw-bold text-dark lh-1">
                                                    @item.FechaHora.Day
                                                </span>
                                            </div>
                                            <div class="d-none d-lg-block">
                                                <span class="small text-muted d-block">@item.FechaHora.ToString("dddd")</span>
                                                <span class="small text-muted">@item.FechaHora.ToString("yyyy")</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="fw-bold text-dark">
                                            @item.FechaHora.ToString("hh:mm tt")
                                        </div>
                                        <small class="text-muted">
                                            <i class="fas fa-hourglass-half me-1"></i> @((int)item.DuracionMinutos) min
                                        </small>
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-success bg-opacity-10 text-success rounded-circle d-flex justify-content-center align-items-center me-2"
                                                 style="width: 30px; height: 30px; font-size: 0.8rem;">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <span class="fw-bold text-dark">@item.PacienteNombre</span>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-2"
                                                 style="width: 30px; height: 30px; font-size: 0.8rem;">
                                                <i class="fas fa-user-md"></i>
                                            </div>
                                            <span class="text-muted small">Dr. @item.OdontologoNombre</span>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge @badgeClass rounded-pill border px-3 py-2 fw-normal">
                                            <i class="fas @iconClass me-1"></i> @item.EstatusTexto
                                        </span>
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-white border" title="Ver Detalle" data-bs-toggle="tooltip">
                                                <i class="fas fa-eye text-secondary"></i>
                                            </a>

                                            @if (item.EstatusCita == Enumerables.EstatusCita.Programada)
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-white border" title="Reprogramar" data-bs-toggle="tooltip">
                                                    <i class="fas fa-pen text-primary"></i>
                                                </a>
                                                <button type="button" class="btn btn-sm btn-white border text-danger"
                                                        title="Cancelar Cita" data-bs-toggle="tooltip"
                                                        onclick="confirmarCancelacion(@item.Id, '@Html.Raw(item.PacienteNombre)')">
                                                    <i class="fas fa-times-circle"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-white border-top-0 py-3">
                    @await Html.PartialAsync("_Pagination", Model.Resultados)
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {

            // Select2
            $('.select2-filtro').select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: '(Seleccione)',
                allowClear: true
            });

            // Tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl)
            });
        });

        // SweetAlert
        function confirmarCancelacion(id, paciente) {
            Swal.fire({
                title: '¿Cancelar Cita?',
                text: `Se cancelará la cita programada para ${paciente}.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545', // Rojo
                cancelButtonColor: '#6c757d', // Gris
                confirmButtonText: 'Sí, cancelar cita',
                cancelButtonText: 'No, mantener'
            }).then((result) => {
                if (result.isConfirmed) {
                    enviarPost('@Url.Action("Delete")', id);
                }
            })
        }

        // Función auxiliar para POST
        function enviarPost(url, id) {
            var form = document.createElement('form');
            form.method = 'post';
            form.action = url;

            var inputId = document.createElement('input');
            inputId.type = 'hidden';
            inputId.name = 'id';
            inputId.value = id;
            form.appendChild(inputId);

            // Token AntiForgery
            var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if(tokenInput) {
                var inputToken = inputId.cloneNode();
                inputToken.name = '__RequestVerificationToken';
                inputToken.value = tokenInput.value;
                form.appendChild(inputToken);
            }

            document.body.appendChild(form);
            form.submit();
        }
    </script>
}