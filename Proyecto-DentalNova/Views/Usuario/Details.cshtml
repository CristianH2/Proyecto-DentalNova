@model DentalNova.Core.Repository.Entities.Usuario

@{
    ViewData["Title"] = $"Detalles de {Model.Nombre} {Model.Apellidos}";
}

<div class="container mt-4">
    <div class="card shadow border-info">
        <div class="card-header bg-light p-4">
            <div class="d-flex align-items-center">
                <i class="bi bi-person-circle display-4 me-3 text-primary"></i>
                <div>
                    <h2 class="mb-0">@Model.Nombre @Model.Apellidos</h2>
                    <p class="mb-0 text-muted">Ficha de Información del Usuario</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-6">
                    <h5 class="text-primary"><i class="bi bi-person-vcard"></i> Información Personal</h5>
                    <hr>
                    <dl class="row">
                        <dt class="col-sm-5">ID</dt>
                        <dd class="col-sm-7">@Model.Id</dd>

                        <dt class="col-sm-5">Nombre Completo</dt>
                        <dd class="col-sm-7">@Model.Nombre @Model.Apellidos</dd>

                        <dt class="col-sm-5">Fecha de Nacimiento</dt>
                        <dd class="col-sm-7">@(Model.FechaNacimiento?.ToLongDateString() ?? "No especificado")</dd>

                        <dt class="col-sm-5">Género</dt>
                        <dd class="col-sm-7">
                            @switch (Model.Genero)
                            {
                                case 'M':
                                    <span>Masculino</span>
                                    ; break;
                                case 'F':

                                    <span>Femenino</span>
                                    ; break;
                                case 'O':

                                    <span>Otro</span>
                                    ; break;
                                default:

                                    <span>No especificado</span>
                                    ; break;
                            }
                        </dd>

                        <dt class="col-sm-5">CURP</dt>
                        <dd class="col-sm-7">@Model.CURP</dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <h5 class="text-primary"><i class="bi bi-key-fill"></i> Contacto y Cuenta</h5>
                    <hr>
                    <dl class="row">
                        <dt class="col-sm-5">Correo Electrónico</dt>
                        <dd class="col-sm-7">@Model.CorreoElectronico</dd>

                        <dt class="col-sm-5">Teléfono</dt>
                        <dd class="col-sm-7">@(Model.Telefono ?? "No proporcionado")</dd>

                        <dt class="col-sm-5">Estado de la Cuenta</dt>
                        <dd class="col-sm-7">
                            @if (Model.Activo)
                            {
                                <span class="badge bg-success fs-6">Activo</span>
                            }
                            else
                            {
                                <span class="badge bg-danger fs-6">Inactivo</span>
                            }
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="card-footer text-end bg-light p-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Editar Usuario
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver a la Lista
            </a>
        </div>
    </div>
</div>