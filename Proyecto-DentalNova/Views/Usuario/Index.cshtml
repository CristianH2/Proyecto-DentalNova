@model Proyecto_DentalNova.Models.UsuarioViewModel.UsuarioIndexViewModel

@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="row g-3">
    <div class="col-12 col-xl-3">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center">
                <i class="bi bi-funnel-fill me-2"></i>
                <strong>Filtro de Búsqueda</strong>
            </div>
            <div class="card-body">
                <form method="get" class="vstack gap-3">
                    <div>
                        <label asp-for="Filtro.Id" class="form-label"></label>
                        <input asp-for="Filtro.Id" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="Filtro.NombreLike" class="form-label"></label>
                        <input asp-for="Filtro.NombreLike" class="form-control" placeholder="Contiene..." />
                    </div>
                    <div>
                        <label asp-for="Filtro.ApellidosLike" class="form-label"></label>
                        <input asp-for="Filtro.ApellidosLike" class="form-control" placeholder="Contiene..." />
                    </div>
                    <div>
                        <label asp-for="Filtro.CorreoLike" class="form-label"></label>
                        <input asp-for="Filtro.CorreoLike" class="form-control" placeholder="Contiene..." />
                    </div>
                    <div>
                        <label asp-for="Filtro.TelefonoLike" class="form-label"></label>
                        <input asp-for="Filtro.TelefonoLike" class="form-control" placeholder="Contiene..." />
                    </div>

                    <div>
                        <label class="form-label d-block">Género</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Filtro.Genero" value="" id="generoTodos" @(Model.Filtro.Genero == null ? "checked" : null) />
                            <label class="form-check-label" for="generoTodos">Todos</label>
                        </div>
                        @foreach (var genero in Model.Filtro.Generos)
                        {
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="Filtro.Genero" value="@genero.Value" id="genero_@genero.Value" @(Model.Filtro.Genero?.ToString() == genero.Value ? "checked" : null) />
                                <label class="form-check-label" for="genero_@genero.Value">@genero.Text</label>
                            </div>
                        }
                    </div>
                    
                    <div>
                        <label class="form-label d-block">Estado</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Filtro.Activo" value="" id="estadoTodos" @(Model.Filtro.Activo == null ? "checked" : null) />
                            <label class="form-check-label" for="estadoTodos">Todos</label>
                        </div>
                         <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Filtro.Activo" value="true" id="estadoActivo" @(Model.Filtro.Activo == true ? "checked" : null) />
                            <label class="form-check-label" for="estadoActivo">Activo</label>
                        </div>
                         <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Filtro.Activo" value="false" id="estadoInactivo" @(Model.Filtro.Activo == false ? "checked" : null) />
                            <label class="form-check-label" for="estadoInactivo">Inactivo</label>
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-3">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Aplicar Filtro</button>
                    </div>
                </form>

                <form method="get" class="d-grid mt-2">
                    <button type="submit" class="btn btn-outline-secondary">Mostrar Todos</button>
                </form>

                <hr />
                <a class="btn btn-success w-100" asp-action="Create"><i class="bi bi-plus-circle"></i> Crear Nuevo Usuario</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-9">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>Resultados (@Model.Resultados?.TotalCount ?? 0)</span>
            </div>
            <div class="card-body p-0">
                <form method="get" class="m-0 p-0">
                    @foreach (var prop in Model.Filtro.GetType().GetProperties())
                    {
                        if (prop.Name != "Generos" && prop.Name != "Estados" && prop.GetValue(Model.Filtro) != null)
                        {
                            <input type="hidden" name="Filtro.@prop.Name" value="@prop.GetValue(Model.Filtro)" />
                        }
                    }

                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre Completo</th>
                                    <th>Correo Electrónico</th>
                                    <th>Teléfono</th>
                                    <th>Género</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Resultados != null && Model.Resultados.Any())
                                {
                                    foreach (var item in Model.Resultados)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@item.Nombre @item.Apellidos</td>
                                            <td>@item.CorreoElectronico</td>
                                            <td>@(item.Telefono ?? "N/A")</td>
                                            <td>
                                                @switch (item.Genero)
                                                {
                                                    case 'M': <span>Masculino</span>; break;
                                                    case 'F': <span>Femenino</span>; break;
                                                    case 'O': <span>Otro</span>; break;
                                                    default: <span>No especificado</span>; break;
                                                }
                                            </td>
                                            <td>
                                                @if (item.Activo)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Inactivo</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.Id" title="Detalles">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id" title="Editar">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </a>
                                                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar">
                                                        <i class="bi bi-trash"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" class="text-center text-muted p-4">No se encontraron resultados.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.Resultados != null && Model.Resultados.Any())
                    {
                        <div class="p-3">
                            @await Html.PartialAsync("_Pagination", Model.Resultados)
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>