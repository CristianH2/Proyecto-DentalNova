@model Proyecto_DentalNova.Models.PacienteViewModel.PacienteIndexViewModel
@{
    ViewData["Title"] = "Gestión de Pacientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="row g-3">
    <div class="col-12 col-xl-3">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center"><i class="bi bi-funnel-fill me-2"></i><strong>Filtro de Búsqueda</strong></div>
            <div class="card-body">
                <form method="get" class="vstack gap-3">
                    <div>
                        <label asp-for="Filtro.Id" class="form-label"></label>
                        <input asp-for="Filtro.Id" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="Filtro.NombreLike" class="form-label"></label>
                        <input asp-for="Filtro.NombreLike" class="form-control" placeholder="Contiene..." />
                    </div>
                    <div>
                        <label asp-for="Filtro.ApellidosLike" class="form-label"></label>
                        <input asp-for="Filtro.ApellidosLike" class="form-control" placeholder="Contiene..." />
                    </div>
                    <div>
                        <label asp-for="Filtro.CorreoLike" class="form-label"></label>
                        <input asp-for="Filtro.CorreoLike" class="form-control" placeholder="Contiene..." />
                    </div>
                    <div>
                        <label asp-for="Filtro.TelefonoLike" class="form-label"></label>
                        <input asp-for="Filtro.TelefonoLike" class="form-control" placeholder="Contiene..." />
                    </div>

                    <div class="row g-2">
                        <div class="col">
                            <label asp-for="Filtro.EdadMin" class="form-label"></label>
                            <input asp-for="Filtro.EdadMin" class="form-control" />
                        </div>
                        <div class="col">
                            <label asp-for="Filtro.EdadMax" class="form-label"></label>
                            <input asp-for="Filtro.EdadMax" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col">
                            <label asp-for="Filtro.FechaDesde" class="form-label"></label>
                            <input asp-for="Filtro.FechaDesde" type="date" class="form-control" />
                        </div>
                        <div class="col">
                            <label asp-for="Filtro.FechaHasta" class="form-label"></label>
                            <input asp-for="Filtro.FechaHasta" type="date" class="form-control" />
                        </div>
                    </div>

                    <div>
                        <label class="form-label d-block">Historial Clínico</label>
                        <div class="form-check"><input asp-for="Filtro.ConAlergias" class="form-check-input" /><label asp-for="Filtro.ConAlergias" class="form-check-label"></label></div>
                        <div class="form-check"><input asp-for="Filtro.ConEnfermedadesCronicas" class="form-check-input" /><label asp-for="Filtro.ConEnfermedadesCronicas" class="form-check-label"></label></div>
                        <div class="form-check"><input asp-for="Filtro.ConMedicamentosActuales" class="form-check-input" /><label asp-for="Filtro.ConMedicamentosActuales" class="form-check-label"></label></div>
                        <div class="form-check"><input asp-for="Filtro.ConAntecedentesFamiliares" class="form-check-input" /><label asp-for="Filtro.ConAntecedentesFamiliares" class="form-check-label"></label></div>
                    </div>

                    <div class="d-grid gap-2 mt-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Aplicar Filtro</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                </form>
                <hr />
                <a class="btn btn-success w-100" asp-action="Create"><i class="bi bi-plus-circle"></i> Registrar Paciente</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-9">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"><span>Resultados (@Model.Resultados?.TotalCount ?? 0)</span></div>
            <div class="card-body p-0">
                <form method="get" class="m-0 p-0">
                    @foreach (var prop in Model.Filtro.GetType().GetProperties())
                    {
                        var value = prop.GetValue(Model.Filtro);
                        if (value != null && (value.GetType() != typeof(bool) || (bool)value))
                        {
                            <input type="hidden" name="Filtro.@prop.Name" value="@value" />
                        }
                    }

                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre del Paciente</th>
                                    <th>Contacto</th>
                                    <th>Edad</th>
                                    <th>Registro</th>
                                    <th class="text-center">Historial</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Resultados != null && Model.Resultados.Any())
                                {
                                    foreach (var item in Model.Resultados)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@item.Usuario?.Nombre @item.Usuario?.Apellidos</td>
                                            <td>
                                                <div class="small">@item.Usuario?.CorreoElectronico</div>
                                                <div class="small text-muted">@item.Usuario?.Telefono</div>
                                            </td>
                                            <td>@item.Edad años</td>
                                            <td>@item.FechaCreacion.ToShortDateString()</td>
                                            <td class="text-center">
                                                @if (item.ConAlergias)
                                                {
                                                    <span class="badge bg-warning text-dark" title="Alergias">A</span>
                                                }
                                                @if (item.ConEnfermedadesCronicas)
                                                {
                                                    <span class="badge bg-danger" title="Enf. Crónicas">C</span>
                                                }
                                                @if (item.ConMedicamentosActuales)
                                                {
                                                    <span class="badge bg-info text-dark" title="Medicamentos">M</span>
                                                }
                                                @if (item.ConAntecedentesFamiliares)
                                                {
                                                    <span class="badge bg-secondary" title="Antecedentes">F</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.Id" title="Ver Expediente"><i class="bi bi-file-earmark-medical"></i></a>
                                                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id" title="Editar Expediente"><i class="bi bi-pencil-square"></i></a>
                                                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar Paciente"><i class="bi bi-trash"></i></a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="7" class="text-center text-muted p-4">No se encontraron resultados.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Resultados != null && Model.Resultados.Any())
                    {
                        <div class="p-3">@await Html.PartialAsync("_Pagination", Model.Resultados)</div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>