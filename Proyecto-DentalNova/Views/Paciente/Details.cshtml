@model DentalNova.Core.Repository.Entities.Paciente

@{
    ViewData["Title"] = $"Expediente de {Model.Usuario?.Nombre} {Model.Usuario?.Apellidos}";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container mt-4">
    <div class="card shadow border-secondary">
        <div class="card-header bg-light p-4">
            <div class="d-flex align-items-center">
                <i class="bi bi-file-earmark-person display-4 me-3 text-primary"></i>
                <div>
                    <h2 class="mb-0">@Model.Usuario?.Nombre @Model.Usuario?.Apellidos</h2>
                    <p class="mb-0 text-muted">Expediente Clínico del Paciente</p>
                </div>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-5">
                    <h5 class="text-primary"><i class="bi bi-person-vcard"></i> Datos Generales</h5>
                    <hr>
                    <dl class="row">
                        <dt class="col-sm-4">Edad</dt>
                        <dd class="col-sm-8">@Model.Edad años</dd>

                        <dt class="col-sm-4">Correo</dt>
                        <dd class="col-sm-8">@Model.Usuario?.CorreoElectronico</dd>

                        <dt class="col-sm-4">Teléfono</dt>
                        <dd class="col-sm-8">@(Model.Usuario?.Telefono ?? "No proporcionado")</dd>

                        <dt class="col-sm-4">Registrado</dt>
                        <dd class="col-sm-8">@Model.FechaCreacion.ToLongDateString()</dd>
                    </dl>
                </div>

                <div class="col-md-7">
                    <h5 class="text-primary"><i class="bi bi-heart-pulse"></i> Historial Clínico</h5>
                    <hr>

                    @if (Model.ConAlergias)
                    {
                        <div class="mb-3">
                            <strong>Alergias:</strong>
                            <p class="ms-3 fst-italic">@Model.Alergias</p>
                        </div>
                    }

                    @if (Model.ConEnfermedadesCronicas)
                    {
                        <div class="mb-3">
                            <strong>Enfermedades Crónicas:</strong>
                            <p class="ms-3 fst-italic">@Model.EnfermedadesCronicas</p>
                        </div>
                    }

                    @if (Model.ConMedicamentosActuales)
                    {
                        <div class="mb-3">
                            <strong>Medicamentos Actuales:</strong>
                            <p class="ms-3 fst-italic">@Model.MedicamentosActuales</p>
                        </div>
                    }

                    @if (Model.ConAntecedentesFamiliares)
                    {
                        <div class="mb-3">
                            <strong>Antecedentes Familiares:</strong>
                            <p class="ms-3 fst-italic">@Model.AntecedentesFamiliares</p>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.Observaciones))
                    {
                        <div class="alert alert-info mt-3">
                            <strong>Observaciones Adicionales:</strong>
                            <p class="mb-0">@Model.Observaciones</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="card-footer text-end bg-light p-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                <i class="bi bi-pencil-square"></i> Editar Expediente
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Volver a la Lista
            </a>
        </div>
    </div>
</div>