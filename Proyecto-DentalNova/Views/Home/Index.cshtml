@using DentalNova.Core.Dtos
@model DashboardDto
@{
    ViewData["Title"] = "Panel de Control";
    var culture = new System.Globalization.CultureInfo("es-MX");
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h2 fw-bold text-dark">Panel Administrativo</h1>
        <p class="text-muted small mb-0">
            Resumen de actividad: <i class="far fa-calendar-alt me-1"></i> @DateTime.Now.ToString("D", culture)
        </p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
        <a asp-controller="Cita" asp-action="Create" class="btn btn-sm btn-primary shadow-sm">
            <i class="fas fa-plus-circle me-1"></i> Nueva Cita
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-0 small text-uppercase fw-bold">Citas Hoy</p>
                        <h3 class="fw-bold text-dark mb-0">@Model.CitasHoy</h3>
                    </div>
                    <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded p-3">
                        <i class="fas fa-calendar-check fs-4"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="badge bg-primary bg-opacity-10 text-primary">@Model.CitasPendientesHoy pendientes</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-0 small text-uppercase fw-bold">Ingresos (Mes)</p>
                        <h3 class="fw-bold text-dark mb-0">@Model.IngresosMes.ToString("C0", culture)</h3>
                    </div>
                    <div class="icon-shape bg-success bg-opacity-10 text-success rounded p-3">
                        <i class="fas fa-dollar-sign fs-4"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="text-muted small">Acumulado actual</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-sm-6 col-xl-3">
        <div class="card shadow-sm border-0 border-start border-info border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-0 small text-uppercase fw-bold">Pacientes Nuevos</p>
                        <h3 class="fw-bold text-dark mb-0">@Model.PacientesNuevosMes</h3>
                    </div>
                    <div class="icon-shape bg-info bg-opacity-10 text-info rounded p-3">
                        <i class="fas fa-user-plus fs-4"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <small class="text-muted">Registrados este mes</small>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-primary"><i class="fas fa-chart-line me-2"></i>Actividad: Últimos 7 Días</h6>
            </div>
            <div class="card-body">
                <canvas id="chartPrincipal" style="max-height: 350px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-primary"><i class="fas fa-clock me-2"></i>Próximas Citas</h6>
            </div>
            <div class="list-group list-group-flush">
                @if (Model.ProximasCitas != null && Model.ProximasCitas.Any())
                {
                    @foreach (var cita in Model.ProximasCitas)
                    {
                        <div class="list-group-item p-3 border-0 border-bottom">
                            <div class="d-flex align-items-center">
                                <div class="flex-shrink-0 text-center me-3">
                                    <div class="bg-light text-dark rounded px-2 py-1 border fw-bold">
                                        @cita.Hora
                                    </div>
                                </div>
                                <div class="flex-grow-1">
                                    <h6 class="mb-0 fw-bold text-dark">@cita.Paciente</h6>
                                    <small class="d-block text-muted">@cita.Tratamiento</small>
                                    <small class="text-primary fst-italic">@cita.Odontologo</small>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <small>No hay citas próximas hoy.</small>
                    </div>
                }
            </div>
            <div class="card-footer bg-white text-center border-0 py-3">
                <a asp-controller="Cita" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">Ver Agenda Completa</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Mapeamos los datos del DTO a arrays simples para JS
        // Usamos .Select para extraer solo las propiedades que necesitamos del objeto complejo
        const labels = @Json.Serialize(Model.DatosGrafico.Select(x => x.DiaSemana));
        const dataCitas = @Json.Serialize(Model.DatosGrafico.Select(x => x.CantidadCitas));
        const dataIngresos = @Json.Serialize(Model.DatosGrafico.Select(x => x.TotalIngresos));

        const ctx = document.getElementById('chartPrincipal').getContext('2d');
        const chartPrincipal = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Citas',
                        data: dataCitas,
                        backgroundColor: 'rgba(13, 110, 253, 0.6)',
                        borderColor: 'rgba(13, 110, 253, 1)',
                        borderWidth: 1,
                        order: 2,
                        yAxisID: 'y'
                    },
                    {
                        label: 'Ingresos ($)',
                        data: dataIngresos,
                        type: 'line',
                        borderColor: 'rgba(25, 135, 84, 1)',
                        backgroundColor: 'rgba(25, 135, 84, 0.1)',
                        borderWidth: 3,
                        tension: 0.3,
                        pointRadius: 4,
                        order: 1,
                        yAxisID: 'y1'
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top' },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                let label = context.dataset.label || '';
                                if (label) { label += ': '; }
                                if (context.dataset.yAxisID === 'y1') {
                                    label += new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(context.raw);
                                } else {
                                    label += context.raw;
                                }
                                return label;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        position: 'left',
                        title: { display: true, text: 'Citas' }
                    },
                    y1: {
                        type: 'linear',
                        display: true,
                        position: 'right',
                        beginAtZero: true,
                        grid: { drawOnChartArea: false },
                        title: { display: true, text: 'Ingresos' }
                    }
                }
            }
        });
    </script>
}