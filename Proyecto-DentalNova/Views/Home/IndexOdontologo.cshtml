@using DentalNova.Core.Dtos
@model DashboardDto
@{
    ViewData["Title"] = "Mi Consultorio";
    var culture = new System.Globalization.CultureInfo("es-MX");
}

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
    <div>
        <h1 class="h2 fw-bold text-dark">Hola, Dr(a). @User.Identity.Name</h1>
        <p class="text-muted small mb-0">
            Agenda del día: <i class="far fa-calendar-alt me-1"></i> @DateTime.Now.ToString("D", culture)
        </p>
    </div>
    <div class="btn-toolbar mb-2 mb-md-0 gap-2">
        <a asp-controller="Cita" asp-action="Agendar" class="btn btn-sm btn-outline-primary">
            <i class="fas fa-list me-1"></i> Agendar Cita
        </a>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12 col-md-4">
        <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-0 small text-uppercase fw-bold">Mis Citas Hoy</p>
                        <h3 class="fw-bold text-dark mb-0">@Model.CitasHoy</h3>
                    </div>
                    <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded p-3">
                        <i class="fas fa-user-md fs-4"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <span class="badge bg-warning bg-opacity-10 text-dark">@Model.CitasPendientesHoy por atender</span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
            <div class="card-body">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <p class="text-muted mb-0 small text-uppercase fw-bold">Atendidos (Mes)</p>
                        <h3 class="fw-bold text-dark mb-0">@Model.PacientesNuevosMes</h3>
                    </div>
                    <div class="icon-shape bg-success bg-opacity-10 text-success rounded p-3">
                        <i class="fas fa-check-circle fs-4"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <small class="text-muted">Pacientes finalizados este mes</small>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card shadow-sm border-0 h-100 bg-light">
            <div class="card-body d-flex flex-column justify-content-center align-items-center text-center">
                <h6 class="fw-bold text-muted mb-3">Acciones Rápidas</h6>
                <div class="d-grid gap-2 w-100">
                    <a asp-controller="Expediente" asp-action="Index" class="btn btn-white border shadow-sm text-start">
                        <i class="fas fa-search me-2 text-primary"></i> Buscar Paciente
                    </a>
                    <a asp-controller="Cita" asp-action="MisCitas" class="btn btn-white border shadow-sm text-start">
                        <i class="fas fa-history me-2 text-info"></i> Ver Agenda Completa
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-12 col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h6 class="m-0 fw-bold text-primary"><i class="fas fa-clock me-2"></i>Mis Próximos Pacientes</h6>
            </div>

            @if (Model.ProximasCitas != null && Model.ProximasCitas.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Hora</th>
                                <th>Paciente</th>
                                <th>Tratamiento</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cita in Model.ProximasCitas)
                            {
                                <tr>
                                    <td class="ps-4 fw-bold">@cita.Hora</td>
                                    <td>@cita.Paciente</td>
                                    <td><span class="badge bg-light text-dark border">@cita.Tratamiento</span></td>
                                    <td>
                                        @{
                                            var color = cita.Estatus == "Programada" ? "primary" :
                                            cita.Estatus == "EnSalaDeEspera" ? "warning" : "secondary";
                                        }
                                        <span class="badge bg-@color bg-opacity-10 text-@color">@cita.Estatus</span>
                                    </td>
                                    <td class="text-end pe-4">
                                        <a asp-controller="Consulta" asp-action="Atender" asp-route-id="@cita.Id" class="btn btn-sm btn-primary">
                                            Atender <i class="fas fa-arrow-right ms-1"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-coffee fa-2x mb-3 opacity-25"></i>
                    <p>No tienes citas pendientes por hoy.</p>
                </div>
            }
        </div>
    </div>

    <div class="col-12 col-lg-4">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3">
                <h6 class="m-0 fw-bold text-primary"><i class="fas fa-chart-bar me-2"></i>Mi Actividad Semanal</h6>
            </div>
            <div class="card-body">
                <canvas id="chartDoctor" style="max-height: 250px;"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const labels = @Json.Serialize(Model.DatosGrafico.Select(x => x.DiaSemana));
        const dataCitas = @Json.Serialize(Model.DatosGrafico.Select(x => x.CantidadCitas));

        const ctx = document.getElementById('chartDoctor').getContext('2d');
        new Chart(ctx, {
            type: 'line', // Línea para el doctor se ve más limpia en espacio pequeño
            data: {
                labels: labels,
                datasets: [{
                    label: 'Pacientes Citados',
                    data: dataCitas,
                    borderColor: 'rgba(13, 110, 253, 1)',
                    backgroundColor: 'rgba(13, 110, 253, 0.1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, ticks: { stepSize: 1 } },
                    x: { grid: { display: false } }
                }
            }
        });
    </script>
}