@model Proyecto_DentalNova.Models.OdontologoViewModel.OdontologoIndexViewModel

@{
    ViewData["Title"] = "Gestión de Odontólogos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="row g-3">
    <div class="col-12 col-xl-3">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center"><i class="bi bi-funnel-fill me-2"></i><strong>Filtro de Búsqueda</strong></div>
            <div class="card-body">
                <form method="get" class="vstack gap-3">
                    <div>
                        <label asp-for="Filtro.Id" class="form-label"></label>
                        <input asp-for="Filtro.Id" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="Filtro.NombreLike" class="form-label"></label>
                        <input asp-for="Filtro.NombreLike" class="form-control" placeholder="Contiene..." />
                    </div>
                    <div>
                        <label asp-for="Filtro.ApellidosLike" class="form-label"></label>
                        <input asp-for="Filtro.ApellidosLike" class="form-control" placeholder="Contiene..." />
                    </div>
                    <div>
                        <label asp-for="Filtro.CorreoLike" class="form-label"></label>
                        <input asp-for="Filtro.CorreoLike" class="form-control" placeholder="Contiene..." />
                    </div>
                    <div>
                        <label asp-for="Filtro.CedulaLike" class="form-label"></label>
                        <input asp-for="Filtro.CedulaLike" class="form-control" placeholder="Contiene..." />
                    </div>
                    <div>
                        <label asp-for="Filtro.EspecialidadId" class="form-label"></label>
                        <select asp-for="Filtro.EspecialidadId" asp-items="@(new SelectList(Model.Filtro.EspecialidadesDisponibles, "Value", "Text"))" class="form-select">
                            <option value="">(Todas las Especialidades)</option>
                        </select>
                    </div>

                    <div class="row g-2">
                        <div class="col">
                            <label asp-for="Filtro.FechaIngresoDesde" class="form-label small"></label>
                            <input asp-for="Filtro.FechaIngresoDesde" type="date" class="form-control" />
                        </div>
                        <div class="col">
                            <label asp-for="Filtro.FechaIngresoHasta" class="form-label small"></label>
                            <input asp-for="Filtro.FechaIngresoHasta" type="date" class="form-control" />
                        </div>
                    </div>

                    <div class="d-grid gap-2 mt-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Aplicar Filtro</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                </form>
                <hr />
                <a class="btn btn-success w-100" asp-action="Create"><i class="bi bi-plus-circle"></i> Registrar Odontólogo</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-9">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"><span>Resultados (@Model.Resultados?.TotalCount ?? 0)</span></div>
            <div class="card-body p-0">
                <form method="get" class="m-0 p-0">
                    @foreach (var prop in Model.Filtro.GetType().GetProperties().Where(p => !p.Name.Contains("Disponibles")))
                    {
                        var value = prop.GetValue(Model.Filtro);
                        if (value != null)
                        {
                            <input type="hidden" name="Filtro.@prop.Name" value="@value" />
                        }
                    }

                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre del Odontólogo</th>
                                    <th>Correo Electrónico</th>
                                    <th>Especialidades</th>
                                    <th>Cédula Profesional</th>
                                    <th>Fecha de Ingreso</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Resultados != null && Model.Resultados.Any())
                                {
                                    foreach (var item in Model.Resultados)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>@item.Usuario?.Nombre @item.Usuario?.Apellidos</td>
                                            <td>@item.Usuario?.CorreoElectronico</td>
                                            <td>
                                                @if (item.Especialidades != null && item.Especialidades.Any())
                                                {
                                                    foreach (var especialidad in item.Especialidades)
                                                    {
                                                        <span class="badge rounded-pill bg-info text-dark me-1">@especialidad.Nombre</span>
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin especialidad</span>
                                                }
                                            </td>
                                            <td>@item.CedulaProfesional</td>
                                            <td>@item.FechaIngreso.ToShortDateString()</td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.Id" title="Ver Perfil"><i class="bi bi-person-lines-fill"></i></a>
                                                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id" title="Editar Perfil"><i class="bi bi-pencil-square"></i></a>
                                                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@item.Id" title="Eliminar Odontólogo"><i class="bi bi-trash"></i></a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="7" class="text-center text-muted p-4">No se encontraron resultados.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Resultados != null && Model.Resultados.Any())
                    {
                        <div class="p-3">@await Html.PartialAsync("_Pagination", Model.Resultados)</div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>




