@model Proyecto_DentalNova.Models.PacienteViewModel.PacienteDetalleViewModel
@using DentalNova.Core.Repository.Entities

@{
    ViewData["Title"] = $"Expediente: {Model.Paciente.Nombre}";
    Layout = "~/Views/Shared/_LayoutOdontologo.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0">Expediente Clínico</h2>
        <p class="text-muted mb-0">Seguimiento integral del paciente.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Cita" asp-action="Agendar" asp-route-pacienteId="@Model.Paciente.Id" class="btn btn-primary shadow-sm">
            <i class="fas fa-calendar-plus me-2"></i> Agendar Cita
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i> Volver al Directorio
        </a>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-4">

        <div class="card shadow-sm border-0 mb-4 text-center p-4">
            <div class="mx-auto bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mb-3 position-relative" style="width: 100px; height: 100px;">
                <span class="fs-1 fw-bold text-primary">@Model.Paciente.Nombre.Substring(0, 1)</span>
                <span class="position-absolute bottom-0 end-0 bg-success border border-white rounded-circle p-2" title="Paciente Activo"></span>
            </div>

            <h4 class="fw-bold mb-1">@Model.Paciente.Nombre @Model.Paciente.Apellidos</h4>
            <p class="text-muted small mb-3 badge bg-light text-dark border font-monospace">ID: #@Model.Paciente.Id</p>

            <div class="d-flex justify-content-center gap-2 mb-4">
                @if (!string.IsNullOrEmpty(Model.Paciente.CorreoElectronico))
                {
                    <a href="mailto:@Model.Paciente.CorreoElectronico" class="btn btn-sm btn-white border text-secondary shadow-sm" data-bs-toggle="tooltip" title="Enviar Correo">
                        <i class="fas fa-envelope"></i>
                    </a>
                }
                @if (!string.IsNullOrEmpty(Model.Paciente.Telefono))
                {
                    <a href="tel:@Model.Paciente.Telefono" class="btn btn-sm btn-white border text-secondary shadow-sm" data-bs-toggle="tooltip" title="Llamar">
                        <i class="fas fa-phone"></i>
                    </a>
                }
            </div>

            <ul class="list-group list-group-flush text-start small">
                <li class="list-group-item d-flex justify-content-between px-0 bg-transparent border-bottom-0 py-1">
                    <span class="text-muted"><i class="fas fa-birthday-cake me-2 text-secondary"></i> Edad:</span>
                    <span class="fw-bold text-dark">@Model.Paciente.Edad años</span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0 bg-transparent border-bottom-0 py-1">
                    <span class="text-muted"><i class="fas fa-venus-mars me-2 text-secondary"></i> Género:</span>
                    <span class="fw-bold text-dark">
                        @(Model.Paciente.Genero == 'M' ? "Masculino" : (Model.Paciente.Genero == 'F' ? "Femenino" : "No Definido"))
                    </span>
                </li>
                <li class="list-group-item d-flex justify-content-between px-0 bg-transparent border-bottom-0 py-1">
                    <span class="text-muted"><i class="far fa-calendar-check me-2 text-secondary"></i> Última Visita:</span>
                    <span class="fw-bold text-dark">
                        @(Model.UltimaVisita.HasValue? Model.UltimaVisita.Value.ToString("dd MMM yyyy") : "N/A")
                    </span>
                </li>
            </ul>
        </div>

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-danger text-white py-2 d-flex align-items-center">
                <i class="fas fa-notes-medical me-2"></i>
                <h6 class="m-0 fw-bold">Alertas Médicas</h6>
            </div>
            <div class="card-body bg-danger bg-opacity-10">
                @if (Model.Paciente.ConAlergias)
                {
                    <div class="alert alert-white border-danger border-start border-4 shadow-sm mb-2 p-3">
                        <small class="text-danger fw-bold d-block text-uppercase mb-1"><i class="fas fa-exclamation-triangle me-1"></i> Alergias</small>
                        <p class="mb-0 small text-dark">@Model.Paciente.Alergias</p>
                    </div>
                }

                @if (Model.Paciente.ConEnfermedadesCronicas)
                {
                    <div class="alert alert-white border-warning border-start border-4 shadow-sm mb-2 p-3">
                        <small class="text-warning fw-bold d-block text-uppercase mb-1"><i class="fas fa-heartbeat me-1"></i> Enf. Crónicas</small>
                        <p class="mb-0 small text-dark">@Model.Paciente.EnfermedadesCronicas</p>
                    </div>
                }

                @if (!Model.Paciente.ConAlergias && !Model.Paciente.ConEnfermedadesCronicas)
                {
                    <div class="text-center text-muted py-3">
                        <i class="fas fa-check-circle text-success mb-2 fs-4 opacity-50"></i>
                        <p class="small mb-0 fst-italic">Sin antecedentes de riesgo registrados.</p>
                    </div>
                }
            </div>
        </div>

        @if (Model.Paciente.ConMedicamentosActuales)
        {
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-info text-white py-2 d-flex align-items-center">
                    <i class="fas fa-pills me-2"></i>
                    <h6 class="m-0 fw-bold">Tratamiento Farmacológico</h6>
                </div>
                <div class="card-body bg-info bg-opacity-10">
                    <div class="alert alert-white border-info border-start border-4 shadow-sm mb-0 p-3">
                        <small class="text-info fw-bold d-block text-uppercase mb-1">Medicamentos Actuales</small>
                        <p class="mb-0 small text-dark">@Model.Paciente.MedicamentosActuales</p>
                    </div>
                </div>
            </div>
        }

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-header bg-white py-2 d-flex align-items-center border-bottom">
                <i class="fas fa-users me-2 text-primary"></i>
                <h6 class="m-0 fw-bold text-dark">Antecedentes Familiares</h6>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrEmpty(Model.Paciente.AntecedentesFamiliares))
                {
                    <div class="d-flex">
                        <div class="me-3">
                            <i class="fas fa-dna text-secondary opacity-50 fs-4"></i>
                        </div>
                        <div>
                            <p class="small text-dark mb-0" style="line-height: 1.5;">@Model.Paciente.AntecedentesFamiliares</p>
                        </div>
                    </div>
                }
                else
                {
                    <p class="small text-muted mb-0 fst-italic text-center">No se han registrado antecedentes.</p>
                }
            </div>
        </div>

    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm border-0 h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <h5 class="m-0 fw-bold text-primary"><i class="fas fa-history me-2"></i>Historia Clínica</h5>
                <span class="badge bg-light text-dark border">@Model.TotalCitas consultas previas</span>
            </div>

            <div class="card-body bg-light bg-opacity-10 p-4">

                @if (Model.HistorialCitas.Any())
                {
                    <div class="timeline">
                        @foreach (var cita in Model.HistorialCitas)
                        {
                            bool esCompletada = cita.EstatusCita == Enumerables.EstatusCita.Completada;

                            string borderClass = cita.EstatusCita switch
                            {
                                Enumerables.EstatusCita.Completada => "border-success",
                                Enumerables.EstatusCita.Cancelada => "border-danger",
                                Enumerables.EstatusCita.NoAsistida => "border-warning",
                                _ => "border-primary"
                            };

                            string statusIcon = cita.EstatusCita switch
                            {
                                Enumerables.EstatusCita.Completada => "fa-check",
                                Enumerables.EstatusCita.Cancelada => "fa-times",
                                _ => "fa-clock"
                            };

                            <div class="card mb-4 shadow-sm border-0 border-start border-5 @borderClass position-relative">
                                <div class="position-absolute top-0 start-0 translate-middle-y bg-white border rounded-circle d-flex align-items-center justify-content-center shadow-sm"
                                     style="width: 30px; height: 30px; left: -15px; margin-top: 25px;">
                                    <i class="fas @statusIcon small text-secondary"></i>
                                </div>

                                <div class="card-body p-3 ps-4">
                                    <div class="d-flex justify-content-between align-items-start mb-3 border-bottom pb-2">
                                        <div>
                                            <h6 class="fw-bold text-dark mb-0">
                                                @cita.FechaHora.ToString("dddd, dd MMMM yyyy")
                                            </h6>
                                            <small class="text-muted">
                                                <i class="far fa-clock me-1"></i> @cita.FechaHora.ToString("hh:mm tt")
                                                <span class="mx-2">|</span>
                                                <i class="fas fa-user-md me-1"></i> Dr. @cita.OdontologoNombre
                                            </small>
                                        </div>
                                        <span class="badge @(esCompletada ? "bg-success" : "bg-secondary") bg-opacity-10 text-dark border rounded-pill">
                                            @cita.EstatusTexto
                                        </span>
                                    </div>

                                    @if (!string.IsNullOrEmpty(cita.MotivoConsulta))
                                    {
                                        <div class="bg-light p-3 rounded border-start border-3 border-secondary border-opacity-25 mb-3">
                                            <small class="text-muted text-uppercase fw-bold d-block mb-1" style="font-size: 0.7rem;">Notas de Evolución:</small>
                                            <p class="mb-0 text-dark small" style="white-space: pre-wrap; line-height: 1.5;">@cita.MotivoConsulta</p>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="text-muted small fst-italic mb-3">Sin notas registradas.</p>
                                    }

                                    @if (cita.Tratamientos != null && cita.Tratamientos.Any())
                                    {
                                        <div>
                                            <small class="text-muted fw-bold d-block mb-1" style="font-size: 0.75rem;">Procedimientos:</small>
                                            <div class="d-flex flex-wrap gap-2">
                                                @foreach (var t in cita.Tratamientos)
                                                {
                                                    <span class="badge bg-white text-dark border shadow-sm fw-normal py-2 px-3">
                                                        <i class="fas fa-tooth text-info me-2"></i> @t.TratamientoNombre
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <div class="bg-white p-4 rounded-circle d-inline-block shadow-sm mb-3">
                            <i class="fas fa-folder-open fa-3x text-muted opacity-25"></i>
                        </div>
                        <h5 class="text-muted fw-bold">Expediente Nuevo</h5>
                        <p class="text-muted small">No hay historial clínico previo.</p>
                        <a asp-controller="Cita" asp-action="Agendar" asp-route-pacienteId="@Model.Paciente.Id" class="btn btn-sm btn-outline-primary mt-2">
                            Agendar Primera Cita
                        </a>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}