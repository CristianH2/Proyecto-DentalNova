@model Proyecto_DentalNova.Models.PacienteViewModel.PacienteIndexViewModel

@{
    ViewData["Title"] = "Directorio de Pacientes";
    Layout = "~/Views/Shared/_LayoutOdontologo.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0">@ViewData["Title"]</h2>
        <p class="text-muted mb-0">Consulta de expedientes y antecedentes clínicos.</p>
    </div>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between"
         data-bs-toggle="collapse" data-bs-target="#collapseFiltros" style="cursor: pointer;">
        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-search me-2"></i> Búsqueda de Pacientes</h6>
        <i class="fas fa-chevron-down text-muted small"></i>
    </div>

    <div class="collapse show" id="collapseFiltros">
        <div class="card-body bg-light bg-opacity-25">
            <form asp-action="Index" method="get" class="row g-3 align-items-end">

                <div class="col-md-3">
                    <label asp-for="Filtro.NombreLike" class="form-label small fw-bold text-muted text-uppercase">Nombre</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fas fa-user"></i></span>
                        <input asp-for="Filtro.NombreLike" class="form-control" placeholder="Buscar..." />
                    </div>
                </div>

                <div class="col-md-3">
                    <label asp-for="Filtro.ApellidosLike" class="form-label small fw-bold text-muted text-uppercase">Apellidos</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white"><i class="fas fa-font"></i></span>
                        <input asp-for="Filtro.ApellidosLike" class="form-control" placeholder="Buscar..." />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted text-uppercase d-block mb-2">Condiciones Médicas</label>
                    <div class="d-flex gap-3 flex-wrap">
                        <div class="form-check form-switch">
                            <input asp-for="Filtro.ConAlergias" class="form-check-input" type="checkbox" role="switch" id="checkAlergias">
                            <label class="form-check-label small" for="checkAlergias">Alergias</label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="Filtro.ConEnfermedadesCronicas" class="form-check-input" type="checkbox" role="switch" id="checkCronicas">
                            <label class="form-check-label small" for="checkCronicas">Crónicas</label>
                        </div>
                        <div class="form-check form-switch">
                            <input asp-for="Filtro.ConMedicamentosActuales" class="form-check-input" type="checkbox" role="switch" id="checkMedicamentos">
                            <label class="form-check-label small" for="checkMedicamentos">Medicados</label>
                        </div>
                    </div>
                </div>

                <div class="col-md-2">
                    <div class="d-grid w-100 gap-1">
                        <button type="submit" class="btn btn-sm btn-primary fw-bold"><i class="fas fa-search me-1"></i> Buscar</button>
                        <a asp-action="Index" class="btn btn-sm btn-light border text-muted"><i class="fas fa-eraser me-1"></i> Limpiar</a>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">

        <form method="get" class="m-0 p-0">

            <input type="hidden" asp-for="Filtro.NombreLike" />
            <input type="hidden" asp-for="Filtro.ApellidosLike" />
            <input type="hidden" asp-for="Filtro.ConAlergias" />
            <input type="hidden" asp-for="Filtro.ConEnfermedadesCronicas" />
            <input type="hidden" asp-for="Filtro.ConMedicamentosActuales" />
            <input type="hidden" asp-for="Filtro.PageSize" />

            @if (Model.Resultados == null || !Model.Resultados.Any())
            {
                <div class="text-center py-5">
                    <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                        <i class="fas fa-user-slash fa-3x text-secondary opacity-25"></i>
                    </div>
                    <h5 class="text-muted fw-bold">Sin Resultados</h5>
                    <p class="text-muted small mb-0">No se encontraron pacientes con los criterios seleccionados.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase small text-muted">
                            <tr>
                                <th class="ps-4">Paciente</th>
                                <th>Info. Personal</th>
                                <th class="text-center">Alertas Médicas</th>
                                <th class="text-end pe-4">Acción</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Resultados)
                            {
                                // Lógica de Género
                                string generoTexto = "No definido";
                                string generoIcono = "fa-genderless text-muted";

                                if (item.Genero == 'M')
                                {
                                    generoTexto = "Masculino";
                                    generoIcono = "fa-mars text-primary";
                                }
                                else if (item.Genero == 'F')
                                {
                                    generoTexto = "Femenino";
                                    generoIcono = "fa-venus text-danger";
                                }

                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            @{
                                                var iniciales = (!string.IsNullOrEmpty(item.Nombre) ? item.Nombre.Substring(0, 1) : "") +
                                                (!string.IsNullOrEmpty(item.Apellidos) ? item.Apellidos.Substring(0, 1) : "");
                                            }
                                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex justify-content-center align-items-center me-3 fw-bold"
                                                 style="width: 40px; height: 40px; font-size: 0.9rem;">
                                                @iniciales
                                            </div>
                                            <div>
                                                <span class="fw-bold text-dark d-block">@item.Nombre @item.Apellidos</span>
                                                <small class="text-muted"><i class="fas fa-phone-alt me-1 text-secondary"></i> @(item.Telefono ?? "Sin registro")</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <div class="d-flex flex-column">
                                            <span class="text-dark small mb-1">
                                                <i class="fas fa-birthday-cake me-2 text-muted"></i> @item.Edad años
                                            </span>
                                            <span class="text-muted small" title="@generoTexto">
                                                <i class="fas @generoIcono me-2"></i> @generoTexto
                                            </span>
                                        </div>
                                    </td>

                                    <td class="text-center">
                                        @if (!item.ConAlergias && !item.ConEnfermedadesCronicas && !item.ConMedicamentosActuales)
                                        {
                                            <span class="badge bg-light text-muted border fw-normal rounded-pill px-3">
                                                <i class="fas fa-check-circle me-1"></i> Sano
                                            </span>
                                        }
                                        else
                                        {
                                            @if (item.ConAlergias)
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-dark border border-warning border-opacity-25 rounded-pill me-1"
                                                      data-bs-toggle="tooltip" title="Tiene Alergias">
                                                    <i class="fas fa-allergies"></i> <span class="d-none d-lg-inline ms-1">Alergias</span>
                                                </span>
                                            }

                                            @if (item.ConEnfermedadesCronicas)
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 rounded-pill me-1"
                                                      data-bs-toggle="tooltip" title="Enfermedad Crónica">
                                                    <i class="fas fa-heartbeat"></i> <span class="d-none d-lg-inline ms-1">Crónico</span>
                                                </span>
                                            }

                                            @if (item.ConMedicamentosActuales)
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 rounded-pill me-1"
                                                      data-bs-toggle="tooltip" title="Toma Medicamentos">
                                                    <i class="fas fa-pills"></i> <span class="d-none d-lg-inline ms-1">Medicamentos</span>
                                                </span>
                                            }
                                        }
                                    </td>

                                    <td class="text-end pe-4">
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary shadow-sm fw-bold">
                                            <i class="fas fa-folder-open me-2"></i> Expediente
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="card-footer bg-white border-top-0 py-3">
                    @await Html.PartialAsync("_Pagination", Model.Resultados)
                </div>
            }
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Inicializar Tooltips de Bootstrap para ver las alertas médicas al pasar el mouse
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
          return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
}
