@model DentalNova.Core.Repository.Entities.Tratamiento

<div class="card shadow-sm">
    <div class="card-body p-4">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group mb-3">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" placeholder="Ej: Limpieza Dental Profesional" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="form-group mb-3">
            <label asp-for="Descripcion" class="form-label"></label>
            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción detallada del tratamiento (opcional)"></textarea>
            <span asp-validation-for="Descripcion" class="text-danger"></span>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="Costo" class="form-label"></label>
                    <div class="input-group">
                        <span class="input-group-text">$</span>
                        <input asp-for="Costo" type="number" step="0.01" class="form-control" />
                    </div>
                    <span asp-validation-for="Costo" class="text-danger"></span>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-3">
                    <label asp-for="DuracionDias" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="DuracionDias" type="number" class="form-control" />
                        <span class="input-group-text">días</span>
                    </div>
                    <span asp-validation-for="DuracionDias" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="form-group mb-3">
            <label class="form-label">Estado del Tratamiento</label>
            <div class="form-check form-switch p-3 border rounded-3">
                <input asp-for="Activo" class="form-check-input" type="checkbox" role="switch" />
                <label asp-for="Activo" class="form-check-label"></label>
                <div class="form-text">Un tratamiento inactivo no podrá ser seleccionado para nuevas citas.</div>
            </div>
        </div>
    </div>
</div>