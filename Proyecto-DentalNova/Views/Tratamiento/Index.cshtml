@model Proyecto_DentalNova.Models.TratamientoViewModel.TratamientoIndexViewModel

@{
    ViewData["Title"] = "Gestión de Tratamientos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h1>@ViewData["Title"]</h1>
<hr />

<div class="row g-3">
    <div class="col-12 col-xl-3">
        <div class="card shadow-sm">
            <div class="card-header d-flex align-items-center"><i class="bi bi-funnel-fill me-2"></i><strong>Filtro de Búsqueda</strong></div>
            <div class="card-body">
                <form method="get" class="vstack gap-3">
                    <div>
                        <label asp-for="Filtro.Id" class="form-label"></label>
                        <input asp-for="Filtro.Id" class="form-control" />
                    </div>
                    <div>
                        <label asp-for="Filtro.NombreLike" class="form-label"></label>
                        <input asp-for="Filtro.NombreLike" class="form-control" placeholder="Contiene..." />
                    </div>
                    <div class="row g-2">
                        <div class="col">
                            <label asp-for="Filtro.CostoMin" class="form-label"></label>
                            <input asp-for="Filtro.CostoMin" class="form-control" type="number" step="0.01" />
                        </div>
                        <div class="col">
                            <label asp-for="Filtro.CostoMax" class="form-label"></label>
                            <input asp-for="Filtro.CostoMax" class="form-control" type="number" step="0.01" />
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col">
                            <label asp-for="Filtro.DuracionMin" class="form-label"></label>
                            <input asp-for="Filtro.DuracionMin" class="form-control" type="number" />
                        </div>
                        <div class="col">
                            <label asp-for="Filtro.DuracionMax" class="form-label"></label>
                            <input asp-for="Filtro.DuracionMax" class="form-control" type="number" />
                        </div>
                    </div>
                    <div>
                        <label class="form-label d-block">Estado</label>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Filtro.Activo" value="" id="estadoTodos" @(Model.Filtro.Activo == null ? "checked" : null) />
                            <label class="form-check-label" for="estadoTodos">Todos</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Filtro.Activo" value="true" id="estadoActivo" @(Model.Filtro.Activo == true ? "checked" : null) />
                            <label class="form-check-label" for="estadoActivo">Activo</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="radio" name="Filtro.Activo" value="false" id="estadoInactivo" @(Model.Filtro.Activo == false ? "checked" : null) />
                            <label class="form-check-label" for="estadoInactivo">Inactivo</label>
                        </div>
                    </div>
                    <div class="d-grid gap-2 mt-2">
                        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Aplicar Filtro</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
                    </div>
                </form>
                <hr />
                <a class="btn btn-success w-100" asp-action="Create"><i class="bi bi-plus-circle"></i> Crear Nuevo Tratamiento</a>
            </div>
        </div>
    </div>

    <div class="col-12 col-xl-9">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center"><span>Resultados (@Model.Resultados?.TotalCount ?? 0)</span></div>
            <div class="card-body p-0">
                <form method="get" class="m-0 p-0">
                    @foreach (var prop in Model.Filtro.GetType().GetProperties())
                    {
                        var value = prop.GetValue(Model.Filtro);
                        if (value != null)
                        {
                            <input type="hidden" name="Filtro.@prop.Name" value="@value" />
                        }
                    }

                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>ID</th>
                                    <th>Nombre</th>
                                    <th>Costo</th>
                                    <th>Duración</th>
                                    <th>Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Resultados != null && Model.Resultados.Any())
                                {
                                    foreach (var item in Model.Resultados)
                                    {
                                        <tr>
                                            <td>@item.Id</td>
                                            <td>
                                                <strong>@item.Nombre</strong>
                                                <p class="text-muted small mb-0">@item.Descripcion</p>
                                            </td>
                                            <td>@item.Costo.ToString("C")</td>
                                            <td>@item.DuracionDias días</td>
                                            <td>
                                                @if (item.Activo)
                                                {
                                                    <span class="badge bg-success">Activo</span>
                                                }
                                                else
                                                {

                                                    <span class="badge bg-danger">Inactivo</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <div class="btn-group" role="group">
                                                    <a class="btn btn-sm btn-secondary" asp-action="Details" asp-route-id="@item.Id" title="Detalles"><i class="bi bi-eye"></i></a>
                                                    <a class="btn btn-sm btn-primary" asp-action="Edit" asp-route-id="@item.Id" title="Editar"><i class="bi bi-pencil-square"></i></a>
                                                    <a class="btn btn-sm @(item.Activo ? "btn-danger" : "btn-success")" asp-action="ToggleActivo" asp-route-id="@item.Id" title="@(item.Activo ? "Desactivar" : "Activar")">
                                                        <i class="bi @(item.Activo ? "bi-toggle-off" : "bi-toggle-on")"></i>
                                                    </a>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="6" class="text-center text-muted p-4">No se encontraron resultados.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.Resultados != null && Model.Resultados.Any())
                    {
                        <div class="p-3">@await Html.PartialAsync("_Pagination", Model.Resultados)</div>
                    }
                </form>
            </div>
        </div>
    </div>
</div>





