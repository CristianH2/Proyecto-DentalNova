@model Proyecto_DentalNova.Models.ArticuloViewModel.ArticuloIndexViewModel

@{
    ViewData["Title"] = "Inventario General";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-0">@ViewData["Title"]</h2>
        <p class="text-muted mb-0">Control de insumos, materiales y equipos.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary shadow-sm">
        <i class="fas fa-box-open me-2"></i> Nuevo Artículo
    </a>
</div>

<div class="card shadow-sm border-0 mb-4">
    <div class="card-header bg-white py-3 border-bottom d-flex align-items-center justify-content-between"
         data-bs-toggle="collapse" data-bs-target="#collapseFiltros" style="cursor: pointer;">
        <h6 class="m-0 fw-bold text-primary"><i class="fas fa-filter me-2"></i> Filtros de Búsqueda</h6>
        <i class="fas fa-chevron-down text-muted small"></i>
    </div>
    
    <div class="collapse show" id="collapseFiltros">
        <div class="card-body bg-light bg-opacity-25">
            <form asp-action="Index" method="get" class="row g-3">

                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted text-uppercase">Búsqueda</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white text-muted"><i class="fas fa-barcode"></i></span>
                        <input asp-for="Filtro.Busqueda" class="form-control" placeholder="Nombre, Código o Descripción..." />
                    </div>
                </div>

                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted text-uppercase">Categoría</label>
                    <select asp-for="Filtro.Categoria" asp-items="Model.Categorias" class="form-select form-select-sm">
                        <option value="">(Todas las categorías)</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">Estado</label>
                    <select asp-for="Filtro.Activo" asp-items="Model.EstatusOpciones" class="form-select form-select-sm">
                        <option value="">(Todos)</option>
                    </select>
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <div class="d-grid w-100 gap-1">
                        <button type="submit" class="btn btn-sm btn-primary fw-bold" title="Buscar">
                            <i class="fas fa-search me-1"></i> Buscar
                        </button>
                        <a asp-action="Index" class="btn btn-sm btn-light border text-muted" title="Limpiar">
                            <i class="fas fa-eraser me-1"></i> Limpiar
                        </a>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        @if (TempData["MensajeExito"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show m-3">
                <i class="fas fa-check-circle me-2"></i>@TempData["MensajeExito"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <form method="get" class="m-0 p-0">
            @foreach (var prop in Model.Filtro.GetType().GetProperties())
            {
                var value = prop.GetValue(Model.Filtro);
                if (value != null && prop.Name != "Page" && prop.Name != "PageSize")
                {
                    <input type="hidden" name="Filtro.@prop.Name" value="@value" />
                }
            }

            @if (Model.Resultados == null || !Model.Resultados.Any())
            {
                <div class="text-center py-5 text-muted">
                    <div class="bg-light rounded-circle d-inline-flex p-4 mb-3">
                        <i class="fas fa-dolly fa-3x text-secondary opacity-25"></i>
                    </div>
                    <h5 class="fw-bold text-secondary">Inventario Vacío</h5>
                    <p class="mb-0 small">No se encontraron artículos con los filtros aplicados.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-uppercase small text-muted">
                            <tr>
                                <th class="ps-4">Artículo / Código</th>
                                <th>Categoría</th>
                                <th>Existencias</th>
                                <th>Tipo</th>
                                <th>Disponibilidad</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Resultados)
                            {
                                // Lógica visual para Stock
                                string stockClass = "bg-success bg-opacity-10 text-success border-success";
                                string stockIcon = "fa-check";
                                
                                if (item.Stock == 0)
                                {
                                    stockClass = "bg-secondary bg-opacity-10 text-secondary border-secondary";
                                    stockIcon = "fa-times";
                                }
                                else if (item.Stock <= 5)
                                {
                                    stockClass = "bg-danger bg-opacity-10 text-danger border-danger";
                                    stockIcon = "fa-exclamation-triangle";
                                }

                                <tr>
                                    <td class="ps-4">
                                        <div class="d-flex align-items-center">
                                            <div class="bg-primary bg-opacity-10 text-primary rounded p-2 me-3 d-none d-md-block">
                                                <i class="fas fa-cube"></i>
                                            </div>
                                            <div>
                                                <div class="fw-bold text-dark">@item.Nombre</div>
                                                <small class="text-muted font-monospace">
                                                    <i class="fas fa-barcode me-1"></i>@item.Codigo
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge bg-light text-dark border fw-normal">
                                            @item.CategoriaTexto
                                        </span>
                                    </td>

                                    <td>
                                        <div class="d-flex align-items-center">
                                            <span class="badge @stockClass border border-opacity-25 rounded-pill px-3 py-2">
                                                <i class="fas @stockIcon me-1"></i> @item.Stock
                                            </span>
                                            @if(item.Stock <= 5 && item.Stock > 0)
                                            {
                                                <small class="text-danger ms-2 fw-bold" style="font-size: 0.7rem;">¡BAJO!</small>
                                            }
                                            @if(item.Stock == 0)
                                            {
                                                <small class="text-muted ms-2 fst-italic" style="font-size: 0.7rem;">Agotado</small>
                                            }
                                        </div>
                                    </td>

                                    <td>
                                        @if (item.Reutilizable)
                                        {
                                            <span class="text-info small fw-bold" title="Material Reutilizable/Esterilizable">
                                                <i class="fas fa-recycle me-1"></i> Reutilizable
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small" title="Material Desechable">
                                                <i class="fas fa-trash-alt me-1"></i> Desechable
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <div class="form-check form-switch">
                                            <input class="form-check-input" type="checkbox" role="switch"
                                                   style="cursor: pointer;"
                                                   onchange="cambiarEstatus(@item.Id, this)"
                                                   @(item.Activo ? "checked" : "")>
                                            <label class="form-check-label small text-muted">
                                                @(item.Activo ? "Activo" : "Baja")
                                            </label>
                                        </div>
                                    </td>

                                    <td class="text-end pe-4">
                                        <div class="btn-group shadow-sm">
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-white border" title="Editar">
                                                <i class="fas fa-pen text-primary"></i>
                                            </a>
                                            <button type="button" class="btn btn-sm btn-white border text-danger" 
                                                    onclick="confirmarEliminar(@item.Id, '@Html.Raw(item.Nombre)')" title="Eliminar">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (Model.Resultados.TotalPages > 1)
                {
                    <div class="card-footer bg-white border-top-0 py-3">
                        @await Html.PartialAsync("_Pagination", Model.Resultados)
                    </div>
                }
            }
        </form>
    </div>
</div>

<form id="form-eliminar" asp-action="Delete" method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="id-eliminar" />
</form>
@section Scripts {
    <script>
        // Toast para usarlo en las llamadas AJAX
        const Toast = Swal.mixin({
            toast: true,
            position: 'top-end',
            showConfirmButton: false,
            timer: 4000,
            timerProgressBar: true,
            didOpen: (toast) => {
                toast.addEventListener('mouseenter', Swal.stopTimer)
                toast.addEventListener('mouseleave', Swal.resumeTimer)
            }
        });

        $(document).ready(function () {
            // Inicialización de Tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[title]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });

        // --- FUNCIÓN ELIMINAR ---
        function confirmarEliminar(id, nombre) {
            Swal.fire({
                title: '¿Eliminar Artículo?',
                text: `Se dará de baja "${nombre}" del inventario.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc3545',
                cancelButtonColor: '#6c757d',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $('#id-eliminar').val(id);
                    $('#form-eliminar').submit();
                }
            });
        }

        // --- FUNCIÓN AJAX (TOGGLE SWITCH) ---
        function cambiarEstatus(id, element) {
            var $checkbox = $(element);
            var isChecked = $checkbox.is(':checked');

            $checkbox.prop('disabled', true);
            var token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: '@Url.Action("CambiarEstatus")/' + id,
                type: 'POST',
                headers: { 'RequestVerificationToken': token },
                success: function (data) {
                    $checkbox.prop('disabled', false);

                    if(data.success) {
                        // Actualizamos la UI
                        var nuevoTexto = isChecked ? "Activo" : "Baja";
                        $checkbox.next('label').text(nuevoTexto);

                        Toast.fire({
                            icon: 'success',
                            title: 'Estado actualizado correctamente'
                        });
                    } else {
                        // Error lógico del servidor
                        $checkbox.prop('checked', !isChecked);
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: data.message || 'No se pudo actualizar.',
                            confirmButtonColor: '#dc3545'
                        });
                    }
                },
                error: function (xhr, status, error) {
                    // Error de conexión
                    $checkbox.prop('disabled', false);
                    $checkbox.prop('checked', !isChecked);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error de conexión',
                        text: 'No se pudo comunicar con el servidor.',
                        confirmButtonColor: '#dc3545'
                    });
                }
            });
        }
    </script>
}